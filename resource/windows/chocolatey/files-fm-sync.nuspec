  <metadata>
    <id>files-fm-sync</id>
    <version>3.16.7</version>
    <packageSourceUrl>https://github.com/filesfm/Sync</packageSourceUrl>
    <owners>filesfm</owners>
    <title>Files.fm Sync</title>
    <authors>filesfm</authors>
    <projectUrl>https://github.com/filesfm/Sync</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/filesfm/Sync@main/theme/colored/files_fm_sync-icon.svg</iconUrl>
    <copyright>2025 Files.fm SIA</copyright>
    <licenseUrl>https://github.com/filesfm/Sync/blob/main/COPYING</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
